<Window x:Class="Tangocho.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Тангочо"
        Icon="pack://application:,,,/icon.ico"
        Width="520" Height="820" MinWidth="360" MinHeight="560"
        Background="#0C0E12"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <wv2:WebView2 x:Name="Web" />

        <!-- Показывается, если в системе нет WebView2 -->
        <Border x:Name="NoRuntime" Visibility="Collapsed" Background="#0C0E12" Padding="28">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Не хватает компонента WebView2" Foreground="#E8EAF0" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
                <TextBlock Margin="0,10,0,18" Foreground="#8B91A1" FontSize="14" TextWrapping="Wrap"
                           Text="Он встроен в Windows 10 и 11, но на этом компьютере его нет. Установи его с сайта Microsoft и запусти Тангочо снова."/>
                <Button x:Name="GetRuntime" Content="Скачать WebView2" Padding="14,8" HorizontalAlignment="Left" Click="GetRuntime_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
