rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Каждый видит и меняет только свои данные: прогресс и чаты с Ребекой
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /chats/{chatId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
