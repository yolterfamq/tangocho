rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Каждый видит и меняет только свои данные: прогресс и чаты с Ребекой
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      match /chats/{chatId} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }

    // Общие уроки (добавленные по фото) — только для нас двоих
    function isUs() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['lin4ik.04.04@gmail.com', 'danellololmarat@gmail.com'];
    }
    match /lessons/{lessonId} {
      allow read, write: if isUs();
    }
  }
}
